<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://www.idpf.org/2007/opf"
         version="3.0"
         unique-identifier="BookId"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:dcterms="http://purl.org/dc/terms/"
         xml:lang="en"
         xmlns:media="http://www.idpf.org/epub/vocab/overlays/#"
         prefix="ibooks: http://vocabulary.itunes.apple.com/rdf/ibooks/vocabulary-extensions-1.0/">

    <metadata xmlns:dc="http://purl.org/dc/elements/1.1/"
              xmlns:opf="http://www.idpf.org/2007/opf">

        <dc:identifier id="BookId"><%= uuid %></dc:identifier>
        <dc:title><%= title %></dc:title>
        <% if (description) { %><dc:description><%= description %></dc:description><% } %>
        <dc:language><%= lang %></dc:language>
        <meta property="dcterms:modified"><%= new Date(date).toISOString().replace(/\.\d{3}Z$/, 'Z') %></meta>
        <dc:creator><%= author.join(', ') %></dc:creator>
        <dc:publisher><%= publisher %></dc:publisher>
        <dc:date><%= new Date(date).toISOString() %></dc:date>
        <% if (cover) { %><meta name="cover" content="image_cover"/><% } %>

    </metadata>

    <manifest>
        <% if (locals.cover) { %><item id="cover" href="cover.xhtml" media-type="application/xhtml+xml" properties="svg"/><% } %>
        <item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml" />
        <item id="toc" href="toc.xhtml" media-type="application/xhtml+xml" properties="nav"/>
        <item id="css" href="style.css" media-type="text/css" />

        <% if(locals.cover) { %>
        <item id="image_cover" href="cover.<%= coverExtension %>" media-type="<%= coverMediaType %>" properties="cover-image" />
        <% } %>

        <% images.forEach(function(image, index){ %>
        <item id="image_<%= index %>" href="images/<%= image.id %>.<%= image.extension %>" media-type="<%= image.mediaType %>" />
        <% }) %>

        <% content.forEach(function(content, index){ %>
            <% if(!content.isCover){ %>
                <item id="content_<%= index %>_<%= content.id %>" href="<%= content.href %>" media-type="application/xhtml+xml" />
            <% } %>
        <% }) %>

        <% fonts.forEach(function(font, index){%>
        <item id="font_<%= index%>" href="fonts/<%= font %>" media-type="<%= fontMediaType(font) %>" />
        <%})%>
    </manifest>

    <spine toc="ncx">
        <% content.forEach(function(content, index){ %>
            <% if(content.beforeToc && !content.isCover){ %>
                <itemref idref="content_<%= index %>_<%= content.id %>"/>
            <% } %>
        <% }) %>
        <% if (locals.cover) { %><itemref idref="cover"/><% } %>
        <% if (locals.showToC) { %><itemref idref="toc" /><% } %>
        <% content.forEach(function(content, index){ %>
            <% if(!content.beforeToc && !content.isCover){ %>
                <itemref idref="content_<%= index %>_<%= content.id %>"/>
            <% } %>
        <% }) %>
    </spine>
    <guide>
        <% if (locals.cover) { %><reference type="cover" title="Cover" href="cover.xhtml"/><% } %>
        <% if (locals.showToC) { %><reference type="text" title="Table of Content" href="toc.xhtml"/><% } %>
    </guide>
</package>